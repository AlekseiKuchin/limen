# Скопируйте в .env и заполните. Файл .env не коммитится.

# Путь к ключу обезличивания (HMAC). Ключ остаётся у заказчика и никогда не передаётся наружу.
LIMEN_PSEUDO_KEY_FILE=secrets/pseudo.key

# Журнал действий в JSON Lines (для SIEM заказчика). Пусто — журнал не ведётся.
LIMEN_AUDIT_LOG=reports/limen-audit.jsonl

# Только для исследовательского контура: адрес MLflow (например, file:./mlruns). Пусто — логирование выключено.
LIMEN_MLFLOW_URI=
